# TickTick Integration Configuration
# To enable TickTick integration, set these values and change TICKTICK_ENABLED to true

# Method 1: Direct Access Token (Recommended)
# Get your access token from TickTick API or use OAuth2 flow
TICKTICK_ACCESS_TOKEN=your_access_token_here
TICKTICK_ENABLED=false

# Method 2: OAuth2 Flow (Optional - for getting access token)
TICKTICK_CLIENT_ID=your_client_id
TICKTICK_CLIENT_SECRET=your_client_secret
TICKTICK_REDIRECT_URI=http://localhost:8000/api/v1/ticktick/oauth/callback

# Legacy credentials (deprecated - use access token instead)
TICKTICK_USERNAME=your_email@example.com
TICKTICK_PASSWORD=your_password

# Obsidian Integration (existing)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
AUTO_SYNC_ENABLED=false